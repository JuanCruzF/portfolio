---
import Badge from "./Badge.astro";
import BadgeGitHub from "./BadgeGitHub.astro";
---

<div class="flex flex-col items-center text-center">
  <img
    src="me.png"
    alt="Avatar"
    class="w-24 h-24 md:w-32 md:h-32 rounded-full mb-4"
  />

  <h1 class="text-2xl md:text-4xl font-bold">
    Juan Cruz Fucile - <span class="text-purple-500">Programador Web</span>
  </h1>

  <p class="mt-2 text-neutral-300">
    Apasionado por el Desarrollo Web y de Software.
  </p>
  <div class="flex items-center mt-4 gap-4">
    <a
      href="https://www.linkedin.com/in/juan-cruz-fucile-7b1822199/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>

    <a
      href="https://github.com/JuanCruzF"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <BadgeGitHub></BadgeGitHub>
    </a>
  </div>
</div>
