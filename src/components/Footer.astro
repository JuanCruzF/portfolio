---
const currentYear = new Date().getFullYear();
import Rasp from "./icons/Rasp.astro"
---

<footer
    class="relative z-10 opacity-80 m-4 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center"
>
    <div
        class="rounded-lg w-full max-w-screen-xl mx-auto flex flex-col items-center text-center"
    >

        <ul
            class="flex flex-col items-center pb-4 mt-4 space-y-2 md:space-y-0 md:flex-row md:justify-center md:gap-x-8 text-sm font-medium dark:text-white/90"
        >
            <li>
                <a href="me/Juan Cruz Fucile - CV.pdf" download class="hover:underline"
                    >Descargar CV</a
                >
            </li>
            <li>
                <a
                    id="contacto"
                    href="mailto:juancruzfucile@hotmail.com"
                    class="hover:underline">Email</a
                >
            </li>
            <li>
                <a
                    href="https://wa.me/5492932578604"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline">WhatsApp</a
                >
            </li>
        </ul>

        <span class="text-sm text-zinc-800/90 dark:text-zinc-200/90 mb-5">
            © {currentYear}
            <a href="https://www.juancruzfucile.com.ar/" class="hover:underline"
                >Juan Cruz Fucile</a
            >. Todos los derechos reservados. <br />
        </span>
    
    </div>
</footer>
