---
import LinkInline from "./InlineStudies.astro";

interface Props {
  title: string;
  description: string;
  link?: string;
  date: string;
}

const { title, description, link, date } = Astro.props;
---

<div class="relative mx-4 pb-6 border-b border-gray-600">
  <!-- Encabezado con botón -->
  <div class="flex items-center justify-between cursor-pointer toggle-btn py-3">
    <div class="w-full text-center">
      <h3 class="text-lg font-bold text-purple-500">{title}</h3>
    </div>
    <!-- Icono de flecha -->
    <svg
      class="w-5 h-5 text-purple-400 transition-transform duration-300"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </div>

  <!-- Contenido colapsable con altura dinámica -->
  <div
    class="toggle-content overflow-hidden transition-all duration-300 ease-out px-6 pb-4 text-neutral-300 flex flex-col items-center text-center"
    style="max-height: 0; min-height: 18px;"
  >
    <time class="block text-sm text-neutral-300">{date}</time>
    <p class="mt-2" set:html={description} />
    {link && <LinkInline link={link}>Ver Certificado</LinkInline>}
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".toggle-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const content = btn.nextElementSibling as HTMLElement;
        if (content.style.maxHeight === "0px" || !content.style.maxHeight) {
          content.style.maxHeight = content.scrollHeight + "px";
        } else {
          content.style.maxHeight = "0px";
        }

        // Rotar la flecha
        btn.querySelector("svg")?.classList.toggle("rotate-180");
      });
    });
  });
</script>

<style>
  .rotate-180 {
    transform: rotate(180deg);
  }
</style>
