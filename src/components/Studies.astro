---
import StudiesItem from "./StudiesItem.astro";
import { studies } from "../data/studies.js";
---

<ol class="relative mt-10 bg-gray-800 p-4 w-full md:w-3/4 mx-auto rounded-md">
  {
    studies.map((studies) => (
      <li class="text-white p-4">
        <StudiesItem {...studies} />
      </li>
    ))
  }
</ol>
