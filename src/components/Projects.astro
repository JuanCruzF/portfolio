---
import { projects } from "../data/projects.js";
---

<div class="relative w-full md:w-3/4 mx-auto">
  <div id="swiper-projects" class="swiper overflow-hidden">
    <div class="swiper-wrapper">
      {
        projects.map((project, index) => (
          <div
            class="swiper-slide p-4 h-full flex"
            {...{ "data-key": index }}
          >
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full h-full"
            >
              <div class="relative bg-gray-800 p-4 rounded-lg shadow-lg w-full h-full flex flex-col justify-between transition-transform duration-300 hover:scale-105 hover:shadow-2xl hover:brightness-110">
                {project.destacado && (
                  <div class="absolute -top-1 -right-1 z-10">
                    <div class="relative flex items-center justify-center">
                      <!-- Glow background centrado -->
                      <div class="absolute w-7 h-7 md:w-9 md:h-9 bg-gradient-to-r from-yellow-300 via-yellow-400 to-orange-400 rounded-full blur-sm opacity-75 animate-pulse"></div>
                      <!-- Star container with gradient background -->
                      <div class="relative bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-600 p-1.5 rounded-full shadow-xl shadow-yellow-400/40 border border-yellow-200">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 md:w-6 md:h-6 text-white filter drop-shadow-sm">
                          <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <!-- Sparkle effect -->
                      <div class="absolute -top-0.8 -right-0.8 w-5 h-5 bg-white rounded-full opacity-80 animate-ping"></div>
                    </div>
                  </div>
                )}
                <div>
                <img
                  src={project.imagen}
                  alt={project.titulo}
                  class="rounded-lg w-full aspect-video object-cover"
                />
                  <h3 class="text-white text-xl mt-2">{project.titulo}</h3>
                  <p class="text-neutral-300 text-sm mt-1 min-h-[48px]">{project.descripcion}</p>
                </div>
                  <div class="flex flex-wrap gap-2 mt-2">
                    {project.tecnologias.map((tech, i) => (
                      <span
                        {...{ "data-key": i }}
                        class="bg-gray-500 text-white px-3 py-1 rounded-full text-xs font-medium shadow-md"
                      >
                        {tech}
                      </span>
                    ))}
                  </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>

  <button
    class="next-projects absolute top-1/2 -translate-y-1/2 right-[2px] md:-right-8 bg-gray-700 bg-opacity-40 hover:bg-opacity-60 text-white w-10 h-10 flex items-center justify-center rounded-full shadow-lg transition-all z-10"
  >
    &#10095;
  </button>

  <button
    class="prev-projects absolute top-1/2 -translate-y-1/2 left-[2px] md:-left-8 bg-gray-700 bg-opacity-40 hover:bg-opacity-60 text-white w-10 h-10 flex items-center justify-center rounded-full shadow-lg transition-all z-10"
  >
    &#10094;
  </button>

  <div class="pagination-projects flex justify-center space-x-2 mt-4"></div>
</div>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination } from "swiper/modules";

  document.addEventListener("DOMContentLoaded", () => {
    new Swiper("#swiper-projects", {
      modules: [Navigation, Pagination],
      spaceBetween: 20,
      loop: true,
      navigation: {
        nextEl: ".next-projects",
        prevEl: ".prev-projects",
      },
      pagination: {
        el: ".pagination-projects",
        clickable: true,
      },
      breakpoints: {
        640: { slidesPerView: 1 },
        768: { slidesPerView: 1 },
        1024: { slidesPerView: 2 },
      },
    });
  });
</script>
